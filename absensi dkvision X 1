    <!-- JAVASCRIPT INTERAKSI HALAMAN & GRAFIK -->
    <script>
        // Navigasi Antar Halaman
        function switchPage(pageId) {
            document.querySelectorAll('.page-section').forEach(sec => sec.classList.add('hidden'));
            document.getElementById('page-' + pageId).classList.remove('hidden');

            document.querySelectorAll('.nav-link').forEach(link => {
                link.classList.remove('bg-secondary/50', 'text-white');
                link.classList.add('text-cream');
                if(link.getAttribute('data-target') === pageId) {
                    link.classList.add('bg-secondary/50', 'text-white');
                    link.classList.remove('text-cream');
                }
            });

            // Set Title Header
            const titles = {
                'beranda': 'Beranda Utama',
                'kelas': 'Manajemen Kelas',
                'siswa': 'Manajemen Siswa',
                'absensi': 'Formulir Absensi Kehadiran',
                'laporan': 'Rekapitulasi Laporan',
                'informasi': 'Profil & Karakteristik Siswa',
                'jadwal': 'Jadwal Pelajaran'
            };
            document.getElementById('page-title').innerText = titles[pageId];

            // Tutup sidebar di mobile jika diklik
            if(window.innerWidth < 768) {
                toggleSidebar();
            }
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('-translate-x-full');
        }

        // Toggle Keterangan Izin Absensi
        function toggleKet(id, isEnabled) {
            const ketInput = document.getElementById('ket_' + id);
            ketInput.disabled = !isEnabled;
            if(!isEnabled) ketInput.value = '';
        }

        // Switch Jadwal Ganjil / Genap
        function switchJadwal(type) {
            const ganjil = document.getElementById('jadwal-ganjil');
            const genap = document.getElementById('jadwal-genap');
            const btnGanjil = document.getElementById('btn-ganjil');
            const btnGenap = document.getElementById('btn-genap');

            if(type === 'ganjil') {
                ganjil.classList.remove('hidden');
                genap.classList.add('hidden');
                btnGanjil.className = "px-4 py-2 rounded-xl text-xs font-semibold bg-primary text-white transition";
                btnGenap.className = "px-4 py-2 rounded-xl text-xs font-semibold bg-cream/60 text-primary transition";
            } else {
                genap.classList.remove('hidden');
                ganjil.classList.add('hidden');
                btnGenap.className = "px-4 py-2 rounded-xl text-xs font-semibold bg-primary text-white transition";
                btnGanjil.className = "px-4 py-2 rounded-xl text-xs font-semibold bg-cream/60 text-primary transition";
            }
        }

        // Modal Handler
        function openModal(modalId) {
            document.getElementById(modalId).classList.remove('hidden');
        }
        function closeModal(modalId) {
            document.getElementById(modalId).classList.add('hidden');
        }

        // Inisialisasi Chart.js
        window.addEventListener('DOMContentLoaded', () => {
            // Chart Grafik Batang
            const ctxBar = document.getElementById('attendanceChart').getContext('2d');
            new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: ['Senin', 'Selasa', 'Rabu', 'Kamis', 'Jumat'],
                    datasets: [{
                        label: 'Hadir',
                        data: [30, 32, 29, 31, 28],
                        backgroundColor: '#933B5B',
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } }
                }
            });

            // Chart Pie / Donat
            const ctxPie = document.getElementById('pieChart').getContext('2d');
            new Chart(ctxPie, {
                type: 'doughnut',
                data: {
                    labels: ['Hadir', 'Sakit', 'Izin', 'Alpha/Bolos'],
                    datasets: [{
                        data: [85, 8, 5, 2],
                        backgroundColor: ['#933B5B', '#B5728A', '#AABAAE', '#9F9679']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });
        });
    </script>
